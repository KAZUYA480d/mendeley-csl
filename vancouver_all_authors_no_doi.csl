<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="in-text" version="1.0" default-locale="en-US" page-range-format="expanded" initialize-with-hyphen="false">
  <info>
    <title>Vancouver All Authors No DOI</title>
    <id>http://www.zotero.org/styles/vancouver-all-authors-no-doi-custom</id>
    <link href="http://www.zotero.org/styles/vancouver-all-authors-no-doi-custom" rel="self"/>
    <link href="https://www.ncbi.nlm.nih.gov/books/NBK7256/" rel="documentation"/>
    <author>
      <name>OpenAI custom style for user-specified medical reference format</name>
    </author>
    <category citation-format="numeric"/>
    <category field="medicine"/>
    <summary>Numeric citation-sequence style. Bibliography shows all authors, article title, abbreviated journal title, year;volume:pages. DOI, URL and issue are omitted.</summary>
    <updated>2026-09-24T00:00:00+00:00</updated>
    <rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License</rights>
  </info>

  <macro name="author">
    <names variable="author">
      <name name-as-sort-order="all"
            sort-separator=" "
            initialize-with=""
            delimiter=", "/>
      <substitute>
        <names variable="editor"/>
        <text variable="title"/>
      </substitute>
    </names>
  </macro>

  <macro name="journal-title">
    <text variable="container-title" form="short"/>
  </macro>

  <macro name="year">
    <date variable="issued">
      <date-part name="year"/>
    </date>
  </macro>

  <citation collapse="citation-number">
    <sort>
      <key variable="citation-number"/>
    </sort>
    <layout prefix="[" suffix="]" delimiter=",">
      <text variable="citation-number"/>
    </layout>
  </citation>

  <bibliography second-field-align="flush" entry-spacing="0" line-spacing="1">
    <layout>
      <text variable="citation-number" suffix=". "/>
      <group>
        <text macro="author" suffix=". "/>
        <text variable="title" suffix=". "/>
        <text macro="journal-title" suffix=" "/>
        <text macro="year" suffix=";"/>
        <text variable="volume" suffix=":"/>
        <text variable="page" suffix="."/>
      </group>
    </layout>
  </bibliography>
</style>
