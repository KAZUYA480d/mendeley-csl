<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" version="1.0" class="in-text" default-locale="en-US" page-range-format="expanded" initialize-with-hyphen="false">
  <info>
    <title>Vancouver - All Authors - Abbreviated Journal - No DOI</title>
    <id>http://www.zotero.org/styles/vancouver-all-authors-abbrev-journal-no-doi</id>
    <link href="http://www.zotero.org/styles/vancouver-all-authors-abbrev-journal-no-doi" rel="self"/>
    <category citation-format="numeric"/>
    <category field="medicine"/>
    <summary>All authors; sentence-case article titles; abbreviated journals; year, volume and full pages. Omits issue and identifiers. Compatible with CSL 1.0.2.</summary>
    <updated>2026-10-08T00:00:00+00:00</updated>
  </info>
  <locale xml:lang="en-US">
    <terms>
      <term name="page-range-delimiter">-</term>
    </terms>
  </locale>
  <macro name="authors">
    <names variable="author">
      <name name-as-sort-order="all" sort-separator=" " initialize-with="" delimiter=", "/>
    </names>
  </macro>
  <macro name="year">
    <date variable="issued">
      <date-part name="year"/>
    </date>
  </macro>
  <citation collapse="citation-number">
    <sort>
      <key variable="citation-number"/>
    </sort>
    <layout delimiter="," vertical-align="sup">
      <text variable="citation-number"/>
    </layout>
  </citation>
  <bibliography entry-spacing="0" line-spacing="1" second-field-align="flush">
    <sort>
      <key variable="citation-number"/>
    </sort>
    <layout suffix=".">
      <text variable="citation-number" suffix=". "/>
      <group delimiter=". ">
        <text macro="authors"/>
        <text variable="title" text-case="sentence" font-style="normal"/>
        <group delimiter=" ">
          <text variable="container-title" form="short" font-style="normal"/>
          <group delimiter="; ">
            <text macro="year"/>
            <group delimiter=": ">
              <text variable="volume"/>
              <text variable="page"/>
            </group>
          </group>
        </group>
      </group>
    </layout>
  </bibliography>
</style>
